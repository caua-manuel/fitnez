{
    "name": "treino-12-semanas",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "build": "npm run typecheck && vite build && node scripts/verify-build.ts",
        "check": "npm run test:config && npm run typecheck && npm test && npm run build",
        "test:config": "node --test scripts/base-path.test.ts scripts/csp-check.test.ts scripts/build-budget.test.ts"
    },
    "dependencies": {
        "@phosphor-icons/react": "2.1.10",
        "motion": "14.14.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "fake-indexeddb": "6.2.5",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vitest": "5.1.0"
    }
}
